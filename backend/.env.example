# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/umny_ai?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (auto-seeded on first run)
INITIAL_ADMIN_EMAIL=admin@umny.ai
INITIAL_ADMIN_PASSWORD=Admin@123456

# AI Providers (At least one key is recommended for live AI generation)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Configuration (optional, default is *)
CORS_ORIGIN=*
